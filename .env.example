# Template only. Never commit live credentials. Use a private password manager.
APP_URL=https://app.atlasevermore.com
DATA_DIR=/data
PORT=8080
ACCESS_TOKEN_SECRET=
# AI remains paused until budget, access and production tests are approved.
AI_ENABLED=false
AI_ALLOW_GUESTS=false
FREE_SCANS=0
AI_GLOBAL_DAILY_LIMIT=50
AI_GLOBAL_MONTHLY_LIMIT=500
AI_USER_DAILY_LIMIT=10
OPENAI_API_KEY=
OPENAI_MODEL=
RESEND_API_KEY=
RESEND_FROM=
SUPPORT_EMAIL=support@atlasevermore.com
# Private independent storage; do not reuse production-provider credentials.
# Keep the 64-hex encryption key ALSO in a password manager outside Railway.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PREFIX=nutripilot
# Fill legal/store/auth configuration according to the active sales channels.
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_ADDRESS=
# Public SDK key for GET subscription status; no administrative key required.
REVENUECAT_READ_KEY=
# Legacy fallback only (do not create an administrative key for status reads).
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_IDS=

# Optional shared storage. Default remains files until an offline, verified migration.
STORAGE_BACKEND=files
DATABASE_URL=
DATABASE_CA_FILE=
DB_POOL_MAX=5
# Never disable TLS in production. DATABASE_TLS=disabled is for isolated local tests only.
