{
  "appId": "com.atlasevermore.nutripilot",
  "appName": "NutriPilot",
  "webDir": "www",
  "server": {
    "url": "https://app.atlasevermore.com/",
    "cleartext": false,
    "allowNavigation": [
      "app.atlasevermore.com"
    ],
    "errorPath": "index.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#04080A",
    "limitsNavigationsToAppBoundDomains": true,
    "scrollEnabled": true
  },
  "android": {
    "backgroundColor": "#04080A",
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0A100D",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#04080A",
      "overlaysWebView": false
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_nutripilot",
      "iconColor": "#18E08A"
    }
  }
}
