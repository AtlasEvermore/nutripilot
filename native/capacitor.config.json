{
  "appId": "com.atlasevermore.nutripilot",
  "appName": "NutriPilot",
  "webDir": "www",
  "server": {
    "url": "https://app.atlasevermore.com/",
    "cleartext": false,
    "allowNavigation": [
      "app.atlasevermore.com"
    ],
    "errorPath": "index.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F3F4F1",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "backgroundColor": "#F3F4F1",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0A100D",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F3F4F1",
      "overlaysWebView": false
    },
    "GoogleAuth": {
      "scopes": [
        "profile",
        "email"
      ],
      "serverClientId": "COLE_AQUI_O_ID_DO_CLIENTE_WEB.apps.googleusercontent.com",
      "forceCodeForRefreshToken": false
    }
  }
}
