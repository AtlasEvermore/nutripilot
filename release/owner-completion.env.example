# TEMPLATE PÚBLICO. Preencha somente no painel privado do Railway.
# Não coloque endereço pessoal, documentos ou segredos no GitHub.
# Contato já conhecido; mudança preparada no Railway, ainda sem deploy.
SUPPORT_EMAIL=rafabalves@hotmail.com
APP_URL=https://app.atlasevermore.com
# Responsável real: nome completo se pessoa física, ou razão social se pessoa jurídica.
# O nome da variável não exige possuir loja física ou empresa.
LEGAL_COMPANY_NAME=
# Endereço real do responsável, autorizado e confirmado pelo proprietário.
LEGAL_COMPANY_ADDRESS=
# Chaves fornecidas pelo painel RevenueCat, após configurar os dois aplicativos.
# Segredos ficam apenas no servidor; chaves públicas SDK não comprovam compra validada.
# Public SDK key for GET subscription status; no administrative key required.
REVENUECAT_READ_KEY=
# Legacy fallback only (do not create an administrative key for status reads).
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
# URLs finais obtidas somente depois de os aplicativos existirem nas lojas.
APP_STORE_URL=
PLAY_STORE_URL=
# Não criar campos RG/CPF: documentos são enviados diretamente à plataforma que os exigir.
